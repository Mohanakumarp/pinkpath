# --- WEB SETTINGS ---
# When you press 'w' to test in a web browser, it safely uses localhost.
EXPO_PUBLIC_BACKEND_URL_WEB=http://127.0.0.1:8000

# --- MOBILE SETTINGS ---
# When testing on a physical phone, it needs your computer's actual network IP.
# IMPORTANT: Replace 192.168.X.X with your actual IPv4 address!
EXPO_PUBLIC_BACKEND_URL=http://192.168.X.X:8000